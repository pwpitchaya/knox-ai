# Backend only. Never put keys in frontend code or chat messages.
# Obtain an API key in your own OpenAI project and choose an available model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ADMIN_USER=
ADMIN_PASSWORD=
# Keep API documentation disabled in deployed environments unless explicitly needed.
ENABLE_DOCS=false
KNOX_GENERATION_ENABLED=1
# Use the existing cached multilingual-e5-base model; no automatic downloads.
KNOX_SEMANTIC=1
# Set to true on memory-constrained hosts to bypass E5 and use TF-IDF only.
USE_TFIDF_ONLY=false
# Optional data directory relative to the project root. Default: backend/data
# KNOX_DATA_DIR=
